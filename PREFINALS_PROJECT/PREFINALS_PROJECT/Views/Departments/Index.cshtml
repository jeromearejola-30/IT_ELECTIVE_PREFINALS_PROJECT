@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Departments Overview";
}

<div class="container mt-4">
    <h2 class="mb-4">Departments Overview</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 shadow-sm" role="alert">
            <h5 class="alert-heading">No Departments Found</h5>
            <p class="mb-0">There are currently no departments available in the system.</p>
        </div>
    }
    else
    {
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Department Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Employee Count</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dept in Model)
                {
                    <tr>
                        <td><strong>@dept.Name</strong></td>
                        <td>@(dept.Description ?? "N/A")</td>
                        <td>
                            <span class="badge @(dept.IsActive ? "bg-success" : "bg-secondary")">
                                @(dept.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>@dept.EmployeeCount</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>