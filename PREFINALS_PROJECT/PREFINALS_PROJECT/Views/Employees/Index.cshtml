@model IEnumerable<PREFINALS_PROJECT.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="container mt-4">
    <h2 class="mb-4">Employees</h2>

    <form asp-controller="Employees" asp-action="Index" method="get" class="mb-4">
        <div class="input-group" style="max-width: 400px;">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by name..." />
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-warning border-0 shadow-sm" role="alert">
            <h5 class="alert-heading">No Employees Found</h5>
            <p class="mb-0">No matching employee records were found for your query.</p>
        </div>
    }
    else
    {
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Job Title</th>
                    <th>Department</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in Model)
                {
                    <tr>
                        <td><strong>@emp.FullName</strong></td>
                        <td>@emp.Email</td>
                        <td>@emp.JobTitle</td>
                        <td>@(emp.Department?.Name ?? "N/A")</td>
                        <td>
                            <span class="badge @(emp.IsActive ? "bg-success" : "bg-danger")">
                                @(emp.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>